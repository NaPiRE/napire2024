d <- load_data_2024(data_path = "../../data", file = "data_preprocessed.csv") %>%
select(lfdn, v_3, Country, v_1, v_457, v_16, v_357, v_377, v_17, !!sym(v)) %>%
drop_na()
str(d)
f <- bf(v_359 ~ 1 + v_3 + Country + v_1 + v_457 + v_16 + v_357 + v_377 + v_17)
# get_prior(f, data = d, family = cumulative("probit"))
p <- c(
set_prior("normal(0, 3)", class = "Intercept"),
set_prior("normal(0, 0.1)", class = "b")
)
m.prior <-
brm(data = d, family = cumulative("probit"), formula = f, prior = p,
iter = 2000, warmup = 1000, chains = 4, cores = 4,
seed = 4, sample_prior="only",
file = paste0("../fits/variance.", v, ".prior"), file_refit = "on_change"
)
priorpc <- brms::pp_check(m.prior, ndraws=100, type = "bars")
priorpc
ggsave('../../figures/variance/v359-prior.pdf', device = "pdf", width = 6, height = 4, unit = "in")
m <-
brm(data = d, family = cumulative("probit"), formula = f, prior = p,
iter = 2000, warmup = 1000, chains = 4, cores = 4, seed = 4,
file = paste0("../fits/variance.", v), file_refit = "on_change"
)
postpc <- brms::pp_check(m, ndraws=100, type="bars")
postpc
ggsave('../../figures/variance/v359-posterior.pdf', device = "pdf", width = 6, height = 4, unit = "in")
d.priorpc <- data.frame(priorpc$data) %>% mutate(type = "Prior")
d.postpc <- data.frame(postpc$data) %>% mutate(type = "Posterior")
d.observed <- select(d.priorpc, x, y_obs) %>%
mutate(x = factor(x, levels = 5:1, rev(c("Very good", "Good", "Neutral", "Bad", "Very bad")), ordered = TRUE))
d.predictions <- rbind(d.priorpc, d.postpc) %>%
mutate(
type = factor(type, levels = c("Prior", "Posterior"), ordered = TRUE),
x = factor(x, levels = 5:1, rev(c("Very good", "Good", "Neutral", "Bad", "Very bad")), ordered = TRUE))
ggplot(d.predictions, aes(x = x)) +
geom_bar(d.observed, mapping = aes(x = x, y = y_obs), stat = "identity", fill = "grey") +
geom_point(aes(y = m, color = type), position = position_dodge(width = 0.5)) +
geom_errorbar(aes(ymin = l, ymax = h, color = type), position = position_dodge(width = 0.5), width=0.3) +
labs(x = "Response options", y = "Predicted and actual responses", color = "Predictive Check") +
scale_color_brewer(palette = "Dark2") +
theme_bw()
ggsave('../../figures/variance/v359-prior-posterior.pdf', device = "pdf", width = 6, height = 3, unit = "in")
posterior.distributions <- posterior_summary(m) %>%
as.data.frame() %>%
tibble::rownames_to_column("term") %>%
filter(grepl("^b_", term) & !grepl("^b_Intercept", term)) %>%
mutate(abs_est = abs(Estimate)) %>%
arrange(desc(abs_est))
mcmc_plot(m, variable = posterior.distributions$term,
type = "intervals", prob = 0.5, prob_outer = 0.95)
ceff <- conditional_effects(m, "v_1", categorical = TRUE, prob = 0.95)[[1]] %>%
mutate(effect2__ = factor(effect2__, ordered = TRUE))
avg <- ceff %>%
group_by(effect2__) %>%
summarize(avg = mean(estimate__)) %>%
mutate(effect2__ = factor(effect2__, ordered = TRUE))
ggplot(ceff, aes(color = effect2__)) +
geom_point(aes(x = effect1__, y = estimate__), position = position_dodge(width = 0.8)) +
geom_errorbar(aes(x = effect1__, ymin = lower__, ymax = upper__), position = position_dodge(width = 0.8)) +
geom_hline(data = avg, mapping = aes(yintercept = avg, color = effect2__), linetype = "dotted", alpha = 0.7) +
geom_hline(yintercept = level.common, color = "grey", linetype = "dashed") +
scale_y_continuous(labels = scales::percent) +
labs(y = "Likelihood of selecting the option", x = "Sector", color = "Options") +
ggtitle(paste0("Industrial sector affecting ", vname)) +
theme_bw() +
theme(
axis.text.x = element_text(angle = 60, vjust = 1, hjust=1),
axis.title.x = element_blank()
)
ggsave("../../figures/variance/v359-marginal-sector.pdf", device = "pdf",
width = 8, height = 4.5, unit = "in")
conditional_effects(m, "v_3", categorical = TRUE, prob = 0.95)[[1]] %>%
mutate(effect2__ = factor(effect2__, ordered = TRUE)) %>%
ggplot(aes(x = effect1__)) +
geom_line(aes(y = estimate__, color = effect2__)) +
geom_ribbon(aes(ymin = lower__, ymax = upper__, fill = effect2__), alpha = 0.2) +
geom_hline(yintercept = 0.2, color = "grey", linetype = "dashed") +
geom_vline(xintercept = 100, color = "black", linetype = "dotted") +
labs(x = "Company size", y = "Likelihood of selecting the option",
color = "Response", fill = "Response") +
scale_y_continuous(labels = scales::percent) +
ggtitle(paste0("Project size affecting ", vname)) +
theme_bw()
conditional_effects(m, "v_3", categorical = TRUE, prob = 0.95)[[1]] %>%
mutate(effect2__ = factor(effect2__, ordered = TRUE)) %>%
ggplot(aes(x = effect1__)) +
geom_line(aes(y = estimate__, color = effect2__)) +
geom_ribbon(aes(ymin = lower__, ymax = upper__, fill = effect2__), alpha = 0.2) +
geom_hline(yintercept = 0.2, color = "grey", linetype = "dashed") +
geom_vline(xintercept = 100, color = "black", linetype = "dotted") +
labs(x = "Company size", y = "Likelihood of selecting the option",
color = "Response", fill = "Response") +
scale_y_continuous(labels = scales::percent) +
ggtitle(paste0("Project size affecting ", vname)) +
theme_bw()
ggsave("../../figures/variance/v359-marginal-size.pdf", device = "pdf",
width = 8, height = 4.5, unit = "in")
conditional_effects(m, "v_3", categorical = TRUE, prob = 0.95)[[1]] %>%
mutate(effect2__ = factor(effect2__, ordered = TRUE)) %>%
ggplot(aes(x = effect1__)) +
geom_line(aes(y = estimate__, color = effect2__)) +
geom_ribbon(aes(ymin = lower__, ymax = upper__, fill = effect2__), alpha = 0.2) +
geom_hline(yintercept = 0.2, color = "grey", linetype = "dashed") +
geom_vline(xintercept = 100, color = "black", linetype = "dotted") +
labs(x = "Project size", y = "Likelihood of selecting the option",
color = "Response", fill = "Response") +
scale_y_continuous(labels = scales::percent) +
ggtitle(paste0("Project size affecting ", vname)) +
theme_bw()
ggsave("../../figures/variance/v359-marginal-size.pdf", device = "pdf",
width = 8, height = 4.5, unit = "in")
knitr::opts_chunk$set(echo = TRUE)
library(readxl) # parser for .xlsx files
library(tidyverse) # dialect of R for more elegant data wrangling and visualization
library(patchwork) # arranging figures
library(WorldMapR) # visualizing a distribution over countries of the world
source("util/data-loader.R") # preparation of the raw data
d <- load_data_2024(data_path = "../data", file = "data_preprocessed.csv") %>%
#select_if(c(negate(is.character)) %>%
select(lfdn, duration,
# meta-data
v_3, v_23, Country, ISO, v_1, v_457, v_16, v_357, v_377, v_17,
# communication
v_25, v_359, v_452, v_380, v_368,
# elicitation
v_28, v_29, v_572, v_34, v_36, v_37, v_38, v_39, v_40, v_41, v_42, v_43,
v_44, v_47, v_667, v_668, v_669, v_461, v_454, v_45,
# assumption
v_455,
# benefit
v_482, v_484, v_487,
# documentation
v_76, v_73, v_79, v_68, v_70, v_71, v_74, v_78, v_77, v_75, v_69, v_72,
v_466, v_557, v_576, v_80,
v_87, v_92, v_88, v_91, v_83, v_93, v_89, v_90, v_84, v_86, v_82, v_85,
v_463, v_558, v_575, v_95,
v_577,
v_670, v_671, v_672, v_673, v_674, v_675, v_676, v_677,
# non-functional requirements
v_97, v_98, v_99, v_100, v_101, v_102, v_303, v_103, v_422, v_104,
# reasons to stop requirements analysis
v_559, v_560, v_561, v_562, v_563, v_564, v_565, v_566, v_567, v_568, v_569,
# requirements validation
v_158, v_159, v_160, v_161, v_162, v_573, v_574, v_163,
# problems
v_385, v_386, v_418, v_409, v_410, v_388, v_389, v_392, v_393, v_394,
v_395, v_396, v_397, v_399, v_401, v_402, v_403, v_404, v_411, v_405,
v_408, v_407, v_406, v_387, v_417, v_459, v_571,
# top problems
v_661, v_662, v_663, v_664, v_665
)
#str(d)
country.summary <- d %>%
filter(!(is.na(Country)) & !(is.na(v_28))) %>%
group_by(ISO) %>%
tally() %>%
rename(Responses = "n")
worldplot(data = data.frame(country.summary),
ColName = "Responses",
CountryName = "ISO",
CountryNameType = "isoa2",
rangeVal = c(0, max(country.summary$Responses)),
# annote = TRUE, # show country ISO code
)
# uncomment to save the figure as a file
ggsave(filename = "../figures/descriptive/participation.pdf", device = "pdf",
width = 10, height = 6, units = "in")
country.summary <- d %>%
drop_na() %>%
group_by(ISO) %>%
tally() %>%
rename(Responses = "n")
worldplot(data = data.frame(country.summary),
ColName = "Responses",
CountryName = "ISO",
CountryNameType = "isoa2",
rangeVal = c(0, max(country.summary$Responses)),
# annote = TRUE, # show country ISO code
)
d %>%
filter(!(is.na(v_28)) & v_3 >= 0) %>%
ggplot(aes(x = v_3)) +
geom_histogram(bins = 30) +
labs(x = "People involved in the project", y = "Number of responses") +
theme_bw() +
ggtitle(paste0("People involved in a Project (n=", nrow(drop_na(select(d, v_28))), ")"))
d %>%
filter(!(is.na(v_28)) & v_3 >= 0) %>%
select(lfdn, v_3, v_457) %>%
mutate(v_3l = log(v_3)) %>%
pivot_longer(cols = c(v_3, v_3l), names_to = "variable", values_to = "value") %>%
mutate(variable = factor(variable,
levels = c("v_3", "v_3l"),
labels = c("absolute", "logarithmic"),
ordered = TRUE)) %>%
ggplot(aes(x = value, fill = v_457)) +
geom_histogram(bins = 20) +
labs(x = "People involved in the project", y = "Number of responses", fill = "Way of working") +
facet_wrap(~variable, scales = "free") +
theme_bw() +
theme(legend.position = "bottom") +
ggtitle(paste0("People involved in a Project per different Ways-of-Working (n=", nrow(drop_na(select(d, v_28))), ")"))
d %>%
filter(!(is.na(v_28))) %>%
ggplot(aes(y = v_1, fill = v_1)) +
geom_bar() +
labs(x = "Number of responses") +
theme_bw() +
theme(axis.title.y = element_blank()) +
guides(fill = "none") +
geom_text(aes(label = after_stat(count)), stat = "count", hjust = 1.5, vjust = 0.3, colour = "white",
size = 3) +
ggtitle(paste0("Main industrial sector of your project (n=", nrow(drop_na(select(d, v_28))), ")"))
d %>%
filter(!(is.na(v_28))) %>%
ggplot(aes(y = v_16)) +
geom_bar() +
geom_text(aes(label = after_stat(count)), stat = "count", hjust = 1.5, vjust = 0.3, colour = "white",
size = 3) +
labs(x = "Number of responses") +
theme_bw() +
theme(axis.title.y = element_blank()) +
ggtitle(paste0("Does your project involve external partners? (n=", nrow(drop_na(select(d, v_28))), ")"))
d %>%
filter(!(is.na(v_28))) %>%
ggplot(aes(y = v_357)) +
geom_bar() +
geom_text(aes(label = after_stat(count)), stat = "count", hjust = 1.5, vjust = 0.3, colour = "white",
size = 3) +
labs(x = "Number of responses") +
theme_bw() +
theme(axis.title.y = element_blank()) +
ggtitle(paste0("Is your project distributed? (n=", nrow(drop_na(select(d, v_28))), ")"))
d %>%
filter(!(is.na(v_28))) %>%
ggplot(aes(y = v_377, fill = v_377)) +
geom_bar() +
geom_text(aes(label = after_stat(count)), stat = "count", hjust = 1.5, vjust = 0.3, colour = "white",
size = 3) +
labs(x = "Number of responses") +
theme_bw() +
theme(axis.title.y = element_blank()) +
guides(fill = "none") +
scale_y_discrete(limits = rev) +
ggtitle(paste0("Degree of Virtualization (n=", nrow(drop_na(select(d, v_28))), ")"))
d %>%
filter(!(is.na(v_28))) %>%
ggplot(aes(y = v_17, fill = v_17)) +
geom_bar() +
geom_text(aes(label = after_stat(count)), stat = "count", hjust = 1.5, vjust = 0.3, colour = "white",
size = 3) +
labs(x = "Number of responses") +
theme_bw() +
theme(axis.title.y = element_blank()) +
guides(fill = "none") +
scale_y_discrete(limits = rev) +
ggtitle(paste0("Main role of the respondent (n=", nrow(drop_na(select(d, v_28))), ")"))
d %>%
filter(!(is.na(v_28))) %>%
select(v_25, v_359, v_452) %>%
drop_na() %>%
pivot_longer(cols = c(v_25, v_359, v_452),
names_to = "question", values_to = "answer") %>%
mutate(question = factor(question, levels = c("v_25", "v_359", "v_452"),
labels = c(
"Customer relationship",
"Intra-team communication",
"Inter-team communication"
))) %>%
ggplot(aes(y = question, fill = answer)) +
geom_bar(position = "stack", stat = "count") +
geom_text(aes(label = after_stat(count)), position = "stack", stat = "count",
hjust = 1.2, colour = "white", size = 3) +
labs(x = "Number of responses", fill = "Options") +
theme_bw() +
theme(legend.position = "right", axis.title.y = element_blank()) +
#ggtitle(paste0("Rating Communication (n=", nrow(drop_na(select(d, v_28))), ")"))
guides(fill = guide_legend(reverse = TRUE)) +
scale_y_discrete(limits = rev)
ggsave("../figures/descriptive/communication.pdf", device = "pdf",
width = 20, height = 5, unit = "cm")
d %>%
filter(!(is.na(v_28))) %>%
select(v_25, v_359, v_452) %>%
