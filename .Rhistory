completeness <- map_dfr(names(var_groups), function(g) {
vars_g <- var_groups[[g]]
d_sub <- d %>% select(any_of(vars_g))
tibble(
group      = g,
n_min      = sum(complete.cases(d_sub)),                 # all vars in group non-NA
n_max      = d_sub %>%
summarise(across(everything(), ~ sum(!is.na(.)))) %>%
as.numeric() %>%
max()                                                   # best single variable
)
})
completeness
completeness_long <- completeness %>%
pivot_longer(cols = c(n_min, n_max), names_to = "type", values_to = "n") %>%
mutate(type = recode(type, n_min = "Min (all complete)", n_max = "Max (best single item)"))
ggplot(completeness_long, aes(x = fct_reorder(group, n, .fun = max), y = n, fill = type)) +
geom_col(position = "dodge") +
geom_text(aes(label = n), position = position_dodge(width = 0.9), hjust = -0.1, size = 3) +
coord_flip() +
scale_fill_manual(values = c("Min (all complete)" = "steelblue", "Max (best single item)" = "lightsteelblue")) +
labs(x = NULL, y = "Number of rows", fill = NULL,
title = "Data availability by group: min (all questions) vs. max (best question)") +
theme_minimal(base_size = 12)
#ggsave("../../figures/dropout-complete.pdf", device = "pdf",
#       width = 16, height = 5, unit = "cm")
ggplot(completeness, aes(y = fct_reorder(group, n_max))) +
geom_segment(aes(x = n_min, xend = n_max, yend = group), color = "grey70", linewidth = 1) +
geom_point(aes(x = n_min), color = "steelblue", size = 3) +
geom_point(aes(x = n_max), color = "firebrick", size = 3) +
labs(x = "Number of rows", y = NULL,
title = "Range of data availability per group",
subtitle = "Blue = all questions answered · Red = best single question") +
theme_minimal(base_size = 12)
#ggsave("../../figures/dropout-complete.pdf", device = "pdf",
